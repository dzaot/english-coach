# Copy to .env.local for local development. NAMES ONLY: never commit real values.

# "mock" (default): offline AI, no keys, the full flow works locally.
# "publik": real AI through publik API (https://publikhq.com/api/v1).
AI_PROVIDER=

# "on" shows Sign in with publik before the app. Default: on when AI_PROVIDER=publik, off otherwise.
PUBLIK_GATE=

# publik app token (pat_...). Minted by the publik setup skill (device flow). Server only.
PUBLIK_APP_TOKEN=

# 32+ random characters. Encrypts publik install keys and own keys at rest. Example: openssl rand -base64 48
APP_SECRET=

# SQLite file. Put it on a persistent disk in production.
DATABASE_PATH=

# Optional. Development only: use this publik key with the gate off (same as the publik module's override).
PUBLIK_API_KEY=

# Optional. Defaults: https://publikhq.com, tts-1, alloy, linux, balanced.
PUBLIK_ORIGIN=
PUBLIK_TTS_MODEL=
PUBLIK_TTS_VOICE=
PUBLIK_INSTALL_OS=
REPLY_TIER=
